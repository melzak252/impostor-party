# Required in production: exact public HTTP(S) origin without trailing slash or path
APP_ORIGIN=https://party.example.com

# Localhost port bound on the host for the reverse proxy (Nginx / HAProxy / Caddy)
HOST_PORT=3000

# Container image tag or immutable digest from GitHub Container Registry
IMPOSTOR_IMAGE=ghcr.io/melzak252/impostor-party:latest
